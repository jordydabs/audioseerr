# AudioSeerr — copy to .env and fill in your values
#   cp .env.example .env
#
# ⚠️  Before starting with NODE_ENV=production you MUST set JWT_SECRET and
#     ADMIN_PASS below. AudioSeerr refuses to boot with a blank or sample
#     value, and the container will restart-loop until you do (check
#     `docker compose logs`).

PORT=7575

# Set to "production" when deploying. In production AudioSeerr REFUSES to start
# if JWT_SECRET or ADMIN_PASS are blank or still sample/placeholder values —
# this prevents accidentally exposing an instance with guessable credentials.
# The bundled docker-compose.yml already sets NODE_ENV=production.
NODE_ENV=production

# Timezone — controls when daily request limits reset (local midnight vs UTC).
TZ=UTC

# Lidarr (optional here — can also be set in-app under Admin → Connections)
LIDARR_URL=http://your-lidarr:8686
LIDARR_API_KEY=your_lidarr_api_key_here

# Last.fm (optional — adds a second similarity graph and tag-based mood matching)
LASTFM_API_KEY=your_lastfm_api_key_here

# Admin account — created on FIRST START ONLY (afterwards the stored password
# hash is what counts, and you change it in the app). ADMIN_PASS must be set
# for that first start — not blank, not a sample value. Once the admin exists
# it is no longer read, so you may blank or remove it then.
ADMIN_USER=admin
ADMIN_PASS=

# JWT secret — MUST be a long random string (32+ chars) in production.
# Generate one with:  openssl rand -hex 32
# Leave blank and production will refuse to start until you set it.
JWT_SECRET=

# How long a browser session lasts, in days (1-365; default 365).
# Sessions can now be revoked (changing a password or a user's role invalidates
# existing tokens), so a shorter window is cheap insurance if the instance is
# reachable from outside your LAN.
#SESSION_DAYS=30

# Set when AudioSeerr runs behind a reverse proxy, so rate limiting sees the
# real client IP instead of the proxy's. Use a hop count (1), an IP/CIDR list,
# or "loopback". Leaving this UNSET behind a proxy means every client shares one
# rate-limit bucket; setting it when NOT proxied lets clients spoof their IP.
#TRUST_PROXY=1

# Data directory (where db.json is stored)
# Docker: /app/data (matches the compose volume)   Bare metal: ./data
DATA_DIR=/app/data

# ── Docker secrets (optional, recommended for production) ────────────────────
# Every secret above also accepts a *_FILE variant pointing at a file whose
# contents are the secret (how Docker/Swarm secrets and vaults inject creds).
# The _FILE form wins if both are set, so nothing sensitive needs to sit in
# this file. Example:
#   JWT_SECRET_FILE=/run/secrets/jwt_secret
#   LIDARR_API_KEY_FILE=/run/secrets/lidarr_api_key
#   ADMIN_PASS_FILE=/run/secrets/admin_pass

# ── Large Lidarr libraries ───────────────────────────────────────────────────
# AudioSeerr reads your whole artist list to badge what you already own and to
# keep Mood Discovery from suggesting it. On a big library Lidarr can take
# MINUTES to answer GET /api/v1/artist, because it aggregates per-artist
# statistics across every track first (measured: ~240s for 1,500 artists /
# 1.1M tracks). Raise the timeout if `docker logs audioseerr` shows
# "library fetch failed ... Timeout".
#LIDARR_LIBRARY_TIMEOUT_MS=300000     # default 300000 (5 min)
# How long the cached library is reused. Adds are spliced in immediately, so a
# long TTL does not make the "In Library" badges stale — it just avoids paying
# for that slow dump often.
#LIDARR_LIBRARY_TTL_MS=2700000        # default 2700000 (45 min)

# ── Upstream overrides (advanced / offline testing) ──────────────────────────
# Point the discovery pipeline at a fake catalogue instead of the real APIs.
#DEEZER_BASE=https://api.deezer.com
#LASTFM_BASE=https://ws.audioscrobbler.com
#ITUNES_BASE=https://itunes.apple.com
#MB_BASE=https://musicbrainz.org
#APPLE_RSS_BASE=https://rss.applemarketingtools.com

# Apple Music storefront used for the trending / new-release feeds (2-letter
# country code, default "us"). e.g. gb, de, jp, au
#APPLE_STOREFRONT=us
