{
  "name": "audioseerr",
  "version": "2.10.0",
  "description": "Self-hosted music request manager for Lidarr — discover, search, and request artists and albums, with multi-source Mood Discovery, fulfilment tracking and outbound notifications.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev":   "node --watch server.js"
  },
  "keywords": [
    "lidarr", "music", "self-hosted", "overseerr", "requests", "deezer", "lastfm", "docker"
  ],
  "dependencies": {
    "bcryptjs":          "^2.4.3",
    "dotenv":            "^16.6.1",
    "express":           "^4.22.2",
    "express-rate-limit": "^7.5.1",
    "helmet":            "^7.2.0",
    "jsonwebtoken":      "^9.0.2"
  }
}
